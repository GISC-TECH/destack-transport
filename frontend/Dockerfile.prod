# Stage 1: Build
FROM node:20-alpine as builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY . .

# Build for production
RUN npm run build

# Stage 2: Serve with nginx
FROM nginx:alpine

# Install wget for healthcheck
RUN apk add --no-cache wget

# Copy built files
COPY --from=builder /app/dist /usr/share/nginx/html

# Create nginx config with API proxy and health endpoint
RUN cat > /etc/nginx/conf.d/default.conf << 'EOF'
server {
    listen 8000;
    root /usr/share/nginx/html;
    index index.html;

    # Resolver DNS do Docker com cache curto para tolerar reinicios de containers.
    resolver 127.0.0.11 valid=10s;

    # Health check endpoint
    location /health {
        return 200 'OK';
        add_header Content-Type text/plain;
    }

    # Tamanho maximo de upload (anexos de documentos, XMLs, etc.)
    client_max_body_size 50M;

    # Proxy API requests to Django backend
    location /api/ {
        set $upstream_web web;
        proxy_pass http://$upstream_web:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    # Proxy admin requests to Django backend
    location /admin/ {
        set $upstream_web web;
        proxy_pass http://$upstream_web:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    # Serve Django static files directly (collected by web container)
    location /static/ {
        alias /app/static/;
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        try_files $uri =404;
    }

    # Serve Django media files directly (uploads stored in shared volume)
    location /media/ {
        alias /app/media/;
        expires 7d;
        add_header Cache-Control "public" always;
        try_files $uri =404;
    }

    # Assets com hash no nome: cache longo e imutavel
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        try_files $uri =404;
    }

    # index.html e rotas da SPA: nunca cachear para evitar assets quebrados apos deploy
    location / {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        expires 0;
        try_files $uri $uri/ /index.html;
    }
}
EOF

EXPOSE 8000

CMD ["nginx", "-g", "daemon off;"]
