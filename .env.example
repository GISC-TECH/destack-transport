# Exemplo de configurações para DESTACK
# Copie para .env e ajuste conforme necessário

# Django
# Gere uma chave segura com:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DEBUG=False
# Lista de hosts permitidos separados por vírgula (ex: app.exemplo.com)
ALLOWED_HOSTS=
# Origens confiáveis para CSRF, separadas por vírgula (use HTTPS em produção)
CSRF_TRUSTED_ORIGINS=
# Origens permitidas para CORS, separadas por vírgula (use HTTPS em produção)
CORS_ALLOWED_ORIGINS=
# Comece com 1 dia; aumente somente após validar HTTPS em todos os subdomínios.
SECURE_HSTS_SECONDS=86400
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Database (será fornecido pelo docker-compose)
# Substitua __DB_PASSWORD__ por uma senha forte gerada com:
#   openssl rand -hex 32
DATABASE_URL=postgresql://destack_user:__DB_PASSWORD__@postgres:5432/destack_db

# Redis (será fornecido pelo docker-compose)
# Gere uma senha forte com:
#   openssl rand -hex 32
REDIS_PASSWORD=
# As URLs abaixo utilizam a variável REDIS_PASSWORD definida acima.
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
REDIS_CACHE_URL=redis://:${REDIS_PASSWORD}@redis:6379/15

# Static/Media files
STATIC_ROOT=/app/static
MEDIA_ROOT=/app/media

# MinIO Object Storage (S3-compatible)
# Defina USE_MINIO=true para usar MinIO em vez de armazenamento local.
# Use pares diferentes: ROOT administra o MinIO; ACCESS/SECRET pertencem ao Django.
USE_MINIO=true
MINIO_ROOT_USER=destack_minio_root
MINIO_ROOT_PASSWORD=
MINIO_ACCESS_KEY=destack
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=destack-media
MINIO_ENDPOINT_URL=http://destack_minio:9000
MINIO_PUBLIC_URL=https://media.destacktransporte.com
MINIO_REGION_NAME=us-east-1
MINIO_QUERYSTRING_EXPIRE=300
MINIO_VERIFY_SSL=True
COMPROVANTES_ZIP_MAX_FILES=50
COMPROVANTES_ZIP_MAX_TOTAL_BYTES=104857600

# Timezone
TIME_ZONE=America/Sao_Paulo

# Logs
LOG_LEVEL=INFO

# Upload limits (opcional)
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760

# Celery (opcional)
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/0

# Evolution API - Gateway de WhatsApp self-hosted
# Gere uma chave segura com: openssl rand -hex 32
EVOLUTION_SERVER_URL=http://evolution_api:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=destack
# Opcional: postgres|sqlite (padrao: sqlite)
EVOLUTION_DATABASE_PROVIDER=sqlite
EVOLUTION_DATABASE_URI=file:./evolution-api.db
