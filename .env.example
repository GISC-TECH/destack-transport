# Exemplo de configurações para DESTACK
# Copie para .env e ajuste conforme necessário

# Django
DJANGO_SECRET_KEY=django_secret_key_change_me
DEBUG=False
ALLOWED_HOSTS=*

# Database (será fornecido pelo docker-compose)
DATABASE_URL=postgresql://destack_user:destack_password_change_me@postgres:5432/destack_db

# Redis (será fornecido pelo docker-compose)
REDIS_URL=redis://:redis_password@redis:6379/0
REDIS_CACHE_URL=redis://:redis_password@redis:6379/15

# Static/Media files
STATIC_ROOT=/app/static
MEDIA_ROOT=/app/media

# Timezone
TIME_ZONE=America/Sao_Paulo

# Logs
LOG_LEVEL=INFO

# Celery (opcional)
CELERY_BROKER_URL=redis://:redis_password@redis:6379/0
CELERY_RESULT_BACKEND=redis://:redis_password@redis:6379/0
# EGS XML Collector
EGS_USERNAME=DESTACK
EGS_PASSWORD=change_me
EGS_ACCESS_KEY=change_me
DESTACK_USERNAME=admin
DESTACK_PASSWORD=change_me
