<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="http://www.portalfiscal.inf.br/cte"
           targetNamespace="http://www.portalfiscal.inf.br/cte"
           elementFormDefault="qualified">

  <!-- XSD mínimo para CT-e (tag raiz CTe): valida namespace e campos mínimos do ide. -->

  <xs:complexType name="IdeType">
    <xs:sequence>
      <xs:element name="cUF" type="xs:string" minOccurs="1"/>
      <xs:element name="cCT" type="xs:string" minOccurs="1"/>
      <xs:element name="CFOP" type="xs:string" minOccurs="1"/>
      <xs:element name="natOp" type="xs:string" minOccurs="1"/>
      <xs:element name="mod" type="xs:string" minOccurs="1"/>
      <xs:element name="serie" type="xs:string" minOccurs="1"/>
      <xs:element name="nCT" type="xs:string" minOccurs="1"/>
      <xs:element name="dhEmi" type="xs:string" minOccurs="1"/>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="skip"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="InfCteType">
    <xs:sequence>
      <xs:element name="ide" type="IdeType" minOccurs="1" maxOccurs="1"/>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="skip"/>
    </xs:sequence>
    <xs:attribute name="Id" type="xs:string" use="required"/>
    <xs:attribute name="versao" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="CTeType">
    <xs:sequence>
      <xs:element name="infCte" type="InfCteType" minOccurs="1" maxOccurs="1"/>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="skip"/>
    </xs:sequence>
    <xs:attribute name="versao" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:element name="CTe" type="CTeType"/>

</xs:schema>
