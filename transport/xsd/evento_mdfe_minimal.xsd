<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="http://www.portalfiscal.inf.br/MDFe"
           targetNamespace="http://www.portalfiscal.inf.br/MDFe"
           elementFormDefault="qualified">

  <!-- XSD mínimo para eventos MDF-e: valida apenas a tag raiz e namespace. -->

  <xs:complexType name="AnyContentType">
    <xs:sequence>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="skip"/>
    </xs:sequence>
    <xs:anyAttribute processContents="skip"/>
  </xs:complexType>

  <xs:element name="eventoMDFe" type="AnyContentType"/>
  <xs:element name="procEventoMDFe" type="AnyContentType"/>

</xs:schema>
