<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="http://www.portalfiscal.inf.br/mdfe"
           targetNamespace="http://www.portalfiscal.inf.br/mdfe"
           elementFormDefault="qualified">

  <!-- XSD mínimo para MDF-e processado (tag raiz mdfeProc, namespace minúsculo): aceita qualquer conteúdo. -->

  <xs:complexType name="AnyContentType">
    <xs:sequence>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="skip"/>
    </xs:sequence>
    <xs:anyAttribute processContents="skip"/>
  </xs:complexType>

  <xs:element name="mdfeProc" type="AnyContentType"/>

</xs:schema>
