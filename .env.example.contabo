# Exemplo de configuracoes para deploy no Contabo com Traefik
# Copie para .env e preencha todos os valores marcados com CHANGE_ME

# =============================================================================
# DJANGO
# =============================================================================
# Gere uma chave segura com:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE_ME

DEBUG=False

# Hosts permitidos pelo Django (separados por virgula)
ALLOWED_HOSTS=destacktransporte.com,www.destacktransporte.com

# Origens confiaveis para CSRF (use HTTPS em producao)
CSRF_TRUSTED_ORIGINS=https://destacktransporte.com,https://www.destacktransporte.com

# Origens permitidas para CORS (use HTTPS em producao)
CORS_ALLOWED_ORIGINS=https://destacktransporte.com,https://www.destacktransporte.com

# =============================================================================
# POSTGRESQL
# =============================================================================
POSTGRES_DB=destack_db
POSTGRES_USER=destack_user
# Gere uma senha forte com:
#   openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME

# =============================================================================
# REDIS
# =============================================================================
# Gere uma senha forte com:
#   openssl rand -hex 32
REDIS_PASSWORD=CHANGE_ME

# As URLs abaixo sao montadas automaticamente pelo docker-compose.contabo.yml
# REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
# REDIS_CACHE_URL=redis://:${REDIS_PASSWORD}@redis:6379/15

# =============================================================================
# STATIC / MEDIA
# =============================================================================
STATIC_ROOT=/app/staticfiles
MEDIA_ROOT=/app/media

# =============================================================================
# TIMEZONE & LOGS
# =============================================================================
TIME_ZONE=America/Sao_Paulo
LOG_LEVEL=INFO

# =============================================================================
# UPLOAD LIMITS
# =============================================================================
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760

# =============================================================================
# CELERY
# =============================================================================
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/0

# =============================================================================
# SCRAPER - DESTACK API CREDENTIALS
# =============================================================================
DESTACK_USERNAME=admin
DESTACK_PASSWORD=CHANGE_ME

# =============================================================================
# SCRAPER - EGS SISTEMAS
# =============================================================================
EGS_USERNAME=DESTACK
EGS_PASSWORD=CHANGE_ME
EGS_ACCESS_KEY=57226

# =============================================================================
# EVOLUTION API - Gateway de WhatsApp self-hosted
# =============================================================================
# Gere uma chave segura com: openssl rand -hex 32
EVOLUTION_API_KEY=CHANGE_ME
EVOLUTION_INSTANCE_NAME=destack

# Exemplo usando o proprio Postgres do projeto.
# Ajuste usuario/senha/banco conforme as variaveis acima.
EVOLUTION_DATABASE_PROVIDER=postgresql
EVOLUTION_DATABASE_URI=postgresql://destack_user:CHANGE_ME@postgres:5432/destack_db

# URL publica da Evolution API (se expuser via Traefik)
EVOLUTION_SERVER_URL=https://api.destacktransporte.com
